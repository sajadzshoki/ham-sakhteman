# PostgreSQL connection string used by the Nuxt server, migrations, and seed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ham_sakhteman

# Separate database for tests. The test run truncates every table.
# Use a local database only. Tests refuse non-local hosts and skip DB suites when unset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ham_sakhteman_test

# Pepper for session token and OTP hashes. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-string

# Session cookie (hs_session) lifetime in days.
SESSION_TTL_DAYS=14

# Origin used to build invitation links (/join?code=...). No trailing slash.
APP_BASE_URL=http://localhost:3000

# --- Phone OTP (Kavenegar) ---
# Leave KAVENEGAR_API_KEY empty in development: no SMS is sent, the OTP is the fixed
# dev code below, and /api/auth/otp/request returns it as `devCode`.
# When set, a random 4-digit code is sent via https://api.kavenegar.com/v1/{key}/sms/send.json
KAVENEGAR_API_KEY=
# Optional sender line number
KAVENEGAR_SENDER=
# Fixed code used only when KAVENEGAR_API_KEY is empty
OTP_DEV_CODE=1111
# OTP lifetime in seconds
OTP_TTL_SECONDS=300

# Docker Compose (postgres service + app DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ham_sakhteman

NODE_ENV=development
