# PostgreSQL connection string used by the Nuxt server, migrations, and seed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ham_sakhteman

# Separate database for tests. The test run truncates every table.
# Use a local database only. Tests refuse non-local hosts.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ham_sakhteman_test

# Pepper for session token hashes. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-string

# Session cookie lifetime in days.
SESSION_TTL_DAYS=14

# Origin used to build invitation links. No trailing slash.
APP_BASE_URL=http://localhost:3000

NODE_ENV=development
